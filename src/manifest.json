{
  "name": "Todo",
  "description": "Todo list for self discipline",
  "author": "phalvinayak@gmail.com",
  "version": "1.0",
  "manifest_version": 3,
  "incognito": "split",
  "action": {
    "default_popup": "static/html/popup.html",
    "default_icon": "static/images/todo-logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.json",
        "static/images/*.png",
        "static/icons/*.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "static/images/icon-16.png",
    "32": "static/images/icon-32.png",
    "48": "static/images/icon-48.png",
    "128": "static/images/icon-128.png"
  },
  "permissions": ["storage", "identity"],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["*"],
  "content_scripts": []
}
